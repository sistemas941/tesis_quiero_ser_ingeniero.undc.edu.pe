# ======================================================================
# ¡Quiero ser Ingeniero! - versión 2. Copie este archivo como .env y complételo.
# El archivo .env NUNCA se sube a GitHub.
# ======================================================================

# --- Dominio (debe apuntar a la IP del servidor con un registro DNS tipo A)
DOMINIO=tesis.midominio.pe
# Correo para el aviso de vencimiento de certificados (Let's Encrypt)
CORREO_TLS=correo.del.responsable@midominio.pe

# --- Entorno de pruebas (opcional; otro subdominio apuntando al mismo servidor)
DOMINIO_PRUEBAS=pruebas.tesis.midominio.pe
PRUEBAS_USUARIO=pruebas
# Huella bcrypt de la clave de pruebas. La genera despliegue/scripts/instalar-servidor.sh, o:
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'una-clave-larga'
PRUEBAS_HASH=

# --- Usuario con el que corre la aplicación (el que despliega). Lo completa instalar-servidor.sh: id -u / id -g
UID_APP=1000
GID_APP=1000

# --- Aplicación
# Correo del administrador (el propietario, como en Apps Script)
ADMIN_CORREO=correo.del.administrador@undc.edu.pe
# Hilos que atienden llamadas a la vez (uno por cada consulta a la IA en curso). 4 basta para 1-2 vCPU.
TRABAJADORES=4
# Páginas que pueden insertar la aplicación. Por defecto: el propio sitio y Google Sites.
# Con PERMITIR_INSERTAR = NO (pestaña Config) no se inserta en ninguna. Para cambiarlo, descomente:
# MARCOS_PERMITIDOS=https://sites.google.com https://*.googleusercontent.com https://www.undc.edu.pe

# --- Claves del curso (opcionales; las de los estudiantes nunca se guardan en el servidor)
GEMINI_API_KEY=
CONSENSUS_API_KEY=
OPENALEX_API_KEY=

# --- Migración desde la versión 1
# El mismo valor que la propiedad MIGRACION_SECRETO de Apps Script. Si se importa el .zip de
# exportarTodo(), el secreto viaja dentro y esta línea puede quedar vacía.
MIGRACION_SECRETO=
